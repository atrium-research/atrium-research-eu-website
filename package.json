{
	"name": "@acdh-oeaw/atrium-research-eu-website",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "run-s build:site generate:search-index",
		"build:site": "astro build",
		"dev": "astro dev",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt",
		"generate:search-index": "pagefind --site ./dist/client/",
		"lint:check": "run-p --continue-on-error \"lint:*:check\"",
		"lint:fix": "run-p --continue-on-error \"lint:*:fix\"",
		"lint:code:check": "oxlint",
		"lint:code:fix": "oxlint --fix",
		"lint:styles:check": "stylelint \"./**/*.@(astro|css)\" --cache --ignore-path ./.gitignore",
		"lint:styles:fix": "pnpm run lint:styles:check --fix",
		"preinstall": "npx only-allow pnpm",
		"start": "astro preview",
		"sync": "astro sync",
		"test": "exit 0",
		"test:e2e": "playwright test",
		"test:e2e:codegen": "playwright codegen",
		"test:e2e:install": "playwright install --with-deps",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:update-snapshots": "playwright test --update-snapshots",
		"types:check": "astro check",
		"validate": "run-p format:check lint:check types:check test test:e2e"
	},
	"dependencies": {
		"@acdh-oeaw/keystatic-lib": "^0.4.1",
		"@acdh-oeaw/lib": "^0.1.12",
		"@acdh-oeaw/mdx-lib": "^0.1.4",
		"@acdh-oeaw/style-variants": "^0.1.0",
		"@acdh-oeaw/validate-env": "^0.0.3",
		"@astrojs/mdx": "^8.1.6",
		"@astrojs/node": "^11.1.13",
		"@astrojs/react": "^7.1.9",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.5",
		"@floating-ui/dom": "^1.8.0",
		"@fontsource/barlow": "^5.3.0",
		"@iconify-json/lucide": "^1.2.156",
		"@iconify-json/simple-icons": "^1.2.103",
		"@keystatic/astro": "^6.0.0",
		"@keystatic/core": "^0.6.10",
		"@pagefind/default-ui": "^1.6.0",
		"astro": "^7.4.12",
		"astro-icon": "^1.2.0",
		"astro-loading-indicator": "^0.9.0",
		"astro-tweet": "^0.0.4",
		"date-fns": "^4.4.0",
		"lucide-react": "^0.464.0",
		"pagefind": "^1.6.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-tweet": "^3.3.1",
		"rehype-slug": "^6.0.0",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-mdx-frontmatter": "^5.2.0",
		"remark-smartypants": "^3.0.3",
		"sharp": "^0.35.5",
		"valibot": "^1.5.0",
		"vite": "^8.3.8"
	},
	"devDependencies": {
		"@acdh-oeaw/stylelint-config": "^3.0.3",
		"@acdh-oeaw/tsconfig": "^1.5.1",
		"@astrojs/check": "^0.9.12",
		"@astrojs/compiler-rs": "^0.5.3",
		"@astrojs/ts-plugin": "^1.11.0",
		"@playwright/test": "^1.65.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/hast": "^3.0.5",
		"@types/mdx": "^2.0.14",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"axe-core": "^4.14.1",
		"axe-playwright": "^2.2.2",
		"ci-info": "^4.5.0",
		"eslint-plugin-playwright": "2.12.2",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-regexp": "^3.3.3",
		"eslint-plugin-tailwindcss": "^4.4.0",
		"lefthook": "^2.2.2",
		"npm-run-all2": "^9.0.4",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"oxlint-tsgolint": "^7.0.2007",
		"schema-dts": "^2.1.0",
		"stylelint": "^17.16.0",
		"tailwindcss": "^4.3.5",
		"type-fest": "^6.0.1",
		"typescript": "^6.0.3"
	},
	"stylelint": {
		"extends": "@acdh-oeaw/stylelint-config",
		"rules": {
			"at-rule-prelude-no-invalid": [
				true,
				{
					"ignoreAtRules": [
						"apply"
					]
				}
			]
		}
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.21.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "26.x",
			"onFail": "download"
		}
	},
	"engines": {
		"node": "26.x",
		"runtime": {
			"name": "node",
			"version": "26.x",
			"onFail": "download"
		}
	}
}
