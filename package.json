{
	"name": "@acdh-oeaw/atrium-research-eu-website",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "run-s build:site generate:search-index",
		"build:site": "astro build",
		"dev": "astro dev",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt",
		"generate:search-index": "pagefind --site ./dist/client/",
		"lint:check": "run-p --continue-on-error \"lint:*:check\"",
		"lint:fix": "run-p --continue-on-error \"lint:*:fix\"",
		"lint:code:check": "eslint . --cache",
		"lint:code:fix": "pnpm run lint:code:check --fix",
		"lint:styles:check": "stylelint \"./**/*.@(astro|css)\" --cache --ignore-path ./.gitignore",
		"lint:styles:fix": "pnpm run lint:styles:check --fix",
		"preinstall": "npx only-allow pnpm",
		"start": "astro preview",
		"sync": "astro sync",
		"test": "exit 0",
		"test:e2e": "playwright test",
		"test:e2e:codegen": "playwright codegen",
		"test:e2e:install": "playwright install --with-deps",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:update-snapshots": "playwright test --update-snapshots",
		"types:check": "astro check",
		"validate": "run-p format:check lint:check types:check test test:e2e"
	},
	"dependencies": {
		"@acdh-oeaw/keystatic-lib": "^0.4.1",
		"@acdh-oeaw/lib": "^0.1.12",
		"@acdh-oeaw/mdx-lib": "^0.1.4",
		"@acdh-oeaw/style-variants": "^0.1.0",
		"@acdh-oeaw/validate-env": "^0.0.3",
		"@astrojs/mdx": "^4.3.14",
		"@astrojs/node": "^9.5.5",
		"@astrojs/react": "^4.4.2",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.5",
		"@astrojs/solid-js": "^5.1.3",
		"@floating-ui/dom": "^1.8.0",
		"@fontsource/barlow": "^5.3.0",
		"@iconify-json/lucide": "^1.2.156",
		"@iconify-json/simple-icons": "^1.2.103",
		"@keystatic/astro": "^5.2.0",
		"@keystatic/core": "^0.5.51",
		"@pagefind/default-ui": "^1.6.0",
		"@shikijs/rehype": "^1.29.2",
		"astro": "~5.0.9",
		"astro-icon": "^1.2.0",
		"astro-loading-indicator": "^0.8.0",
		"astro-tweet": "^0.0.4",
		"date-fns": "^4.4.0",
		"lucide-react": "^0.464.0",
		"lucide-solid": "^0.464.0",
		"pagefind": "^1.6.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-tweet": "^3.3.1",
		"rehype-slug": "^6.0.0",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-mdx-frontmatter": "^5.2.0",
		"remark-smartypants": "^3.0.3",
		"satori": "^0.12.2",
		"sharp": "^0.33.5",
		"shiki": "^1.29.2",
		"solid-js": "^1.9.19",
		"valibot": "^1.5.0",
		"vite": "^6.4.6"
	},
	"devDependencies": {
		"@acdh-oeaw/eslint-config": "^2.0.13",
		"@acdh-oeaw/eslint-config-astro": "^2.0.17",
		"@acdh-oeaw/eslint-config-playwright": "^2.0.15",
		"@acdh-oeaw/eslint-config-react": "^2.0.14",
		"@acdh-oeaw/eslint-config-solid": "^2.0.15",
		"@acdh-oeaw/eslint-config-tailwindcss": "^2.0.11",
		"@acdh-oeaw/stylelint-config": "^2.3.2",
		"@acdh-oeaw/tailwindcss-preset": "^0.0.22",
		"@acdh-oeaw/tsconfig": "^1.5.1",
		"@astrojs/check": "^0.9.12",
		"@astrojs/compiler-rs": "^0.5.3",
		"@astrojs/ts-plugin": "^1.11.0",
		"@playwright/test": "^1.65.1",
		"@types/hast": "^3.0.5",
		"@types/mdx": "^2.0.14",
		"@types/node": "^26.6.6",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"autoprefixer": "^10.6.2",
		"axe-core": "^4.14.1",
		"axe-playwright": "^2.2.2",
		"ci-info": "^4.5.0",
		"dotenv": "^16.6.1",
		"dotenv-expand": "^12.0.3",
		"eslint": "^9.39.5",
		"eslint-config-flat-gitignore": "^0.3.0",
		"eslint-plugin-n": "^17.24.0",
		"globals": "^15.15.0",
		"lefthook": "^2.2.2",
		"npm-run-all2": "^7.0.2",
		"oxfmt": "^0.79.0",
		"postcss": "^8.5.33",
		"schema-dts": "^1.1.5",
		"stylelint": "^16.26.1",
		"tailwindcss": "^3.4.19",
		"type-fest": "^4.41.0",
		"typescript": "^5.9.3"
	},
	"browserslist": {
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		],
		"production": [
			">=0.75%",
			"not dead",
			"not op_mini all"
		]
	},
	"stylelint": {
		"extends": "@acdh-oeaw/stylelint-config"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.21.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "26.x",
			"onFail": "download"
		}
	},
	"engines": {
		"node": "26.x",
		"runtime": {
			"name": "node",
			"version": "26.x",
			"onFail": "download"
		}
	},
	"postcss": {
		"plugins": {
			"tailwindcss": {},
			"autoprefixer": {}
		}
	}
}
